msgstr "फ़ाइल नाम इन अक्षरों से शुरू नहीं होना चाहिए: {CHARACTERS}"

#: savegame.py:740
msgid "This is a reserved filename. Please choose a different filename."
msgstr "यह आरक्षित फ़ाइल नाम है। दूसरा नाम चुनो।"

#: savegame.py:743
msgid "Please enter a non-whitespace character."
msgstr "रिक्त के अलावा कोई अक्षर लिखो।"

#: savegame.py:748
msgid "Filename is too long."
msgstr "फ़ाइल नाम बहुत लंबा है।"

