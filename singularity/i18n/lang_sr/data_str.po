msgid "&CPU"
msgstr "&ЦПЈ"

msgctxt "[network] text"
msgid "&Network"
msgstr "&Мрежа"

msgctxt "[reactor] text"
msgid "&Reactor"
msgstr "&Реактор"

msgctxt "[security] text"
msgid "&Security"
msgstr "&Безбедност"

